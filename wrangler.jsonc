{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toposearch-ngi-proxy",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "TILE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 1500, "period": 60 }
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://jonathandevoypcd.github.io"
  }
}
